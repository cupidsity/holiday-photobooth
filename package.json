{
  "name": "holiday-photobooth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify:invite": "esbuild scripts/verify-invite.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-invite.cjs --log-level=error && node node_modules/.cache/verify-invite.cjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  }
}
